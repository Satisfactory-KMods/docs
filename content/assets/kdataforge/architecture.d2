# Render with D2 v0.9.0:
# d2 --layout elk --theme 8 --dark-theme 200 --pad 32 --omit-version architecture.d2 architecture.svg

direction: down

pack_files: "<your-mod>/DataForge/**/*.yml" {
  shape: document
}

scanner: "FKDFPackScanner\npruned recursive scan" {
  shape: hexagon
}

config_registry: "UKDFConfigRegistry (loads first)\n*.config.yml definitions + Configs/Packs values file\nhot/cold values, host overrides" {
  shape: stored_data
}

pack_plan: "pack.yml → FKDFPack\nconfig: conditions, dependency topology\npriority/ref tie-breaks" {
  shape: diamond
}

node_model: "*.yml → parallel ryml parse\nFKDFNode document trees" {
  shape: stored_data
}

prepass: "Template pre-pass\ncfg: / session: / ags: / option: values\nentry conditions" {
  shape: hexagon
}

subsystem: "UKDFSubsystem (GameInstance)\nRunInitialLoad / ReloadAll\nconditions → root-type detection → priority-sorted handler" {
  shape: rectangle
}

stages: "Fixed EKDFStage pipeline\nGameTags → Assets → Localization → CDOChanges\n→ Items → Recipes → Buildings → Schematics\n→ Research → Unlocks → SubsystemMods\n→ RuntimePatches → Validation" {
  shape: queue
}

handlers: "Built-in + third-party handlers\ncdo/sublevel, generated content, assets/curves,\nlocalization, sinkpoints, resourcenode" {
  shape: rectangle
}

reflection: "Reflection engine\nFKDFOpEngine + FKDFValueCodec\n+ FKDFPropertyResolver\n+ apply-time templates ({item:…})" {
  shape: rectangle
}

snapshots: "FKDFVanillaCache\nfirst-write snapshots" {
  shape: cylinder
}

objects: "CDOs, data assets,\ngenerated content, matched objects" {
  shape: stored_data
}

content_requests: "Per-world requests\ncontent registrations + exact-class removals\nsink tables" {
  shape: document
}

world_module: "UKDFWorldModule + UKDFContentRemoveSubsystem\nregistration → schematic/research filtering\n→ save-restored recipe sweep (before BeginPlay)" {
  shape: rectangle
}

records: "FKDFPatchRecord\nreport and editor history" {
  shape: document
}

actor_patches: "UKDFActorPatchSubsystem (per world)\nregistered patches → existing actors at begin play\n+ each newly spawned actor" {
  shape: rectangle
}

node_purges: "UKDFResourceNodeSubsystem (per world)\ndescriptor/node-type rules → node destruction\n+ mesh/scanner/radar cleanup" {
  shape: rectangle
}

config_sync: "AKDFConfigSyncSubsystem (multiplayer)\nhost effective values → clients\nin memory, local files untouched" {
  shape: rectangle
}

pack_files -> scanner: scan
scanner -> config_registry: "1 · read config first"
scanner -> pack_plan
scanner -> node_model
config_registry -> pack_plan: "config: conditions"
config_registry -> prepass: effective values
node_model -> prepass
pack_plan -> subsystem
prepass -> subsystem: "typed refs, {cfg:}, entry conditions"
subsystem -> stages
stages -> handlers
handlers -> reflection: property writes
handlers -> content_requests: queue
content_requests -> world_module: world initialization
reflection -> snapshots
reflection -> objects
reflection -> records
handlers -> actor_patches: actor patch rules
handlers -> node_purges: node purge rules
world_module -> objects: registry/recipe state
actor_patches -> objects: instance writes
node_purges -> objects: world removal
config_registry -> config_sync: "server: rows"
config_sync -> config_registry: "client: host overrides"
config_registry -> subsystem: "hot change → one reload"
